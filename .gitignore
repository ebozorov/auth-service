# Build natijalari (make build, go test -c)
/bin/
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test

# Go test va profiling fayllari
*.out
coverage.*
*.prof
*.pprof

# Go workspace (lokal sozlama)
go.work
go.work.sum

# Maxfiy env fayllar va RSA kalitlar (.env.local umumiy lokal sozlama, repoda qoladi)
.env
.env.*
!.env.local
/certs/

# Swagger UI: make swagger-ui yuklaydi, swagger-initializer.js bizniki
/swagger-ui/*
!/swagger-ui/swagger-initializer.js

# Runtime loglar
/logs/
*.log

# JetBrains (GoLand, IntelliJ)
.idea/
*.iml

# VS Code
.vscode/
*.code-workspace

