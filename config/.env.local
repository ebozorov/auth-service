# Statik sozlamalar: o'zgarsa restart kerak (make reload). Ularni make yuklaydi.
# Limitlar va token muddatlari bu yerda emas, config.yaml da (25-qaror).

# --- app ---
# dev | test | prod
APP_ENV=dev
# dinamik sozlamalar fayli
CONFIG_FILE=config/config.yaml
APP_HOST=0.0.0.0
APP_PORT=5000
# tashqaridan ko'rinadigan manzil, emaildagi link shu bilan boshlanadi
PUBLIC_URL=http://localhost:5000
TRUST_PROXY=false

# --- db ---
DATABASE_URL=postgres://auth:auth@localhost:5433/auth?sslmode=disable
MIGRATIONS_DIR=migrations
# docker/compose.yaml (make services-up) uchun
DB_USER=auth
DB_PASSWORD=auth
DB_NAME=auth
DB_PORT=5433

# --- jwt ---
JWT_PRIVATE_KEY_PATH=certs/private.pem
JWT_ISSUER=http://localhost:5000

# --- swagger ---
# dev/test da standart true, prod da yoqib bo'lmaydi
SWAGGER_UI_ENABLED=true
SWAGGER_UI_DIR=swagger-ui
OPENAPI_FILE=docs/openapi.json

# --- sign-in ---
SIGN_IN_REDIRECT_URL=/

# --- admin ---
# bazada admin bo'lmasa, server ishga tushganda shu email bilan yaratiladi
# dev da standart admin@localhost, test va prod da standart yo'q
INITIAL_ADMIN_EMAIL=admin@localhost
INITIAL_ADMIN_NAME=Admin

# --- smtp ---
# SMTP_HOST bo'sh bo'lsa xat yuborilmaydi, link logga yoziladi (prod da majburiy)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@localhost
